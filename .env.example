# Copy to .env for local development. Keep real values out of git.

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=memory_bank
DB_USER=memory_bank
DB_PASSWORD=memory_bank
DB_POOL_MIN=1
DB_POOL_MAX=5

# Destructive tests recreate only this explicitly allowlisted database.
TEST_DB_NAME=memory_bank_test

# Model/backend profile
SECOND_BRAIN_PROFILE=laptop
BEDROCK_REGION=us-east-1

# Express email push, optional. Leave unset to compose without sending.
EXPRESS_EMAIL_TO=<your-email@example.com>
EXPRESS_EMAIL_FROM=<your-sender@gmail.com>
GMAIL_APP_PASSWORD=<your-gmail-app-password>
