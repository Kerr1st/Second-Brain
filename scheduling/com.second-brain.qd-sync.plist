<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.second-brain.qd-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/second-brain/scripts/jobs/qd_sync.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/path/to/second-brain/logs/qd-sync-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/second-brain/logs/qd-sync-launchd.log</string>
    <key>RunAtLoad</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
